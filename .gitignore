# Resolved secrets and local configuration. Only the .example templates
# are ever committed.
.env
op.env
*.env
!.env.example
!op.env.example

# Local data. The sprint tool stores names, Jira account ids, absence
# figures and free-text notes about colleagues. None of it belongs in a
# repository - see SECURITY.md.
/data/
argus-data/

# The private-string patterns themselves. Committing these would publish
# exactly what they exist to withhold. Only the .example is tracked.
.private-patterns

# Build output.
/argus
/dist
web/dist/*
!web/dist/.gitkeep
node_modules/

.DS_Store

# TypeScript incremental build state.
*.tsbuildinfo
dist/
